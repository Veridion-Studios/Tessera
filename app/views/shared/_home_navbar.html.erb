<%# Marketing navbar — width must match max-w-7xl px-6 sm:px-12 on all sections %>
<header class="sticky top-0 inset-x-0 z-50 border-b border-zinc-200 bg-white/80 backdrop-blur-sm">
  <div class="mx-auto max-w-7xl flex items-center justify-between px-6 sm:px-12 py-4">
    <%= link_to root_path, class: "font-geist-sans text-base font-semibold tracking-tight text-zinc-900" do %>Tessera<% end %>
    <nav class="hidden sm:flex items-center gap-6 text-sm text-zinc-500">
      <%= link_to "Gallery", gallery_path, class: "hover:text-zinc-900 transition-colors #{request.path.start_with?('/gallery') || request.path.start_with?('/profile') ? 'text-zinc-900' : ''}" %>
      <a href="/#how" class="hover:text-zinc-900 transition-colors">How it works</a>
      <a href="/#for-devs" class="hover:text-zinc-900 transition-colors">For developers</a>
      <a href="/#for-clients" class="hover:text-zinc-900 transition-colors">For clients</a>
    </nav>
    <div class="flex items-center gap-2">
      <%= link_to "Sign in", new_user_session_path, class: "btn btn-ghost btn-sm" %>
      <%= link_to "Get started", join_path, class: "btn btn-primary btn-sm" %>
    </div>
  </div>
</header>